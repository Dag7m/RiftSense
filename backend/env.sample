# Seismic Sensor Backend Configuration
# Copy this file to .env and update values

# Database Configuration
# For Docker: use 'postgres' as host (service name) or 'localhost' if connecting from host
DB_HOST=localhost
DB_PORT=5433
DB_NAME=seismic_db
DB_USER=postgres
DB_PASSWORD=postash

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3001

# ML Service Configuration (placeholder)
ML_SERVICE_URL=http://localhost:5000
ML_ENABLED=false

# Event Detection Thresholds
EVENT_CONFIDENCE_THRESHOLD=0.7
STA_LTA_THRESHOLD=3.0
STA_LTA_EVENT_THRESHOLD=4.0
EVENT_TIME_WINDOW_MS=60000

# Allow event creation based on STA/LTA alone (without ML requirement)
# Set to 'true' to enable STA/LTA-only event creation
# When enabled, events will be created if STA/LTA ratio >= STA_LTA_EVENT_THRESHOLD
STA_LTA_ONLY_EVENTS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

